# ──────────────────────────────────────────────────────────────
#  PerGo — Variáveis de ambiente
#  Copie este arquivo: cp .env.example .env
#  Edite os valores necessários e carregue antes de rodar:
#    source .env && go run ./cmd/pergo
# ──────────────────────────────────────────────────────────────

# ------------------------------------
# Runtime / ambiente
# ------------------------------------
# development/dev/local/test permiten defaults inseguros.
# staging/stg/production/prd activan validación fail-closed.
PERGO_ENVIRONMENT=development

# También puede pasarse como argumento:
#   pergo api | pergo webhook | pergo worker | pergo migrate
# "all" existe únicamente para desarrollo local.
PERGO_RUNTIME_PROFILE=all

# En staging/producción las migraciones se ejecutan exclusivamente con el
# perfil/argumento "migrate".
PERGO_RUN_MIGRATIONS=true

# ------------------------------------
# PostgreSQL
# ------------------------------------
# URL de conexão com o banco de dados.
# Padrão docker-compose: porta 5432 (dentro do compose) ou 5433 (host).
PERGO_DATABASE_URL=postgres://postgres:postgres@localhost:5433/pergo?sslmode=disable

# ------------------------------------
# NATS / JetStream
# ------------------------------------
PERGO_NATS_URLS=nats://localhost:4222
# Obligatorios fuera de dev/test. STG y PRD deben usar cuentas distintas.
PERGO_NATS_CREDS_FILE=
PERGO_NATS_CA_FILE=
PERGO_NATS_TLS_SERVER_NAME=
PERGO_NATS_ACCOUNT=
# Producción exige 3 o más réplicas.
PERGO_NATS_STREAM_REPLICAS=1

# ------------------------------------
# HTTP Server
# ------------------------------------
# Porta publicada pelo Docker Compose no host. Altere para 18083 se a 8080
# já estiver ocupada por outro projeto local.
PERGO_HOST_PORT=8080

# Porta interna do processo PerGo (normalmente não deve ser alterada).
PERGO_SERVER_PORT=8080

# ------------------------------------
# Debug Server (pprof + expvar)
# Disponível em http://localhost:6060/debug/pprof/
# ------------------------------------
PERGO_DEBUG_PORT=6060

# ------------------------------------
# Admin Panel
# Senha para login em /admin
# ------------------------------------
PERGO_ADMIN_PASSWORD=troque-esta-senha

# Firma cookies del panel. En staging/producción debe ser un secreto estable,
# aleatorio y de al menos 32 caracteres, compartido por todas las réplicas API.
PERGO_SESSION_SECRET=

# ------------------------------------
# Criptografia (AES-256-GCM)
# Gere uma chave de 32 bytes em base64:
#   openssl rand -base64 32
# OBRIGATÓRIO em produção. Em dev, o servidor usa uma chave padrão insegura.
# ------------------------------------
PERGO_KEK_BASE64=

# ------------------------------------
# URL externa (necessária para media proxy)
# Usada para montar URLs absolutas de mídia enviadas via WABA.
# Em produção: URL pública do servidor (ex: https://api.suaempresa.com)
# ------------------------------------
PERGO_EXTERNAL_URL=http://localhost:8080

# Versión única para todos los adapters Meta (WABA e Instagram). Revise el
# changelog oficial antes de promover un cambio de versión.
PERGO_META_GRAPH_VERSION=v25.0

# ------------------------------------
# WhatsApp Mock local
# Simula envios sem acessar WhatsApp, Meta ou qualquer conta externa.
# E estritamente opt-in: apenas o valor exato "true" habilita o canal.
# ------------------------------------
PERGO_WHATSAPP_MOCK_ENABLED=false

# ------------------------------------
# Media
# "memory" usa el almacenamiento simulado sólo en development/test.
# "disabled" rechaza toda lectura/escritura; es el único modo habilitado en
# staging/producción hasta sustituir el SDK simulado por un adapter S3 real.
# ------------------------------------
PERGO_MEDIA_MODE=memory
PERGO_S3_ENDPOINT=
PERGO_S3_BUCKET=
PERGO_S3_ACCESS_KEY=
PERGO_S3_SECRET_KEY=
PERGO_S3_REGION=us-east-1
# Use "true" para MinIO ou S3-compatível (path-style URLs)
PERGO_S3_USE_PATH_STYLE=false
