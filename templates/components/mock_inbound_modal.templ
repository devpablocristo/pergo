package components

import (
	"github.com/pablojhp.pergo/internal/i18n"
	"github.com/pablojhp.pergo/internal/repository"
)

// MockInboundModal provides an entirely local way to exercise Inbox.
templ MockInboundModal(connections []*repository.Connection) {
	<div id="modal" class="modal fixed inset-0 z-50 flex items-center justify-center bg-black/50 transition-opacity duration-200">
		<div class="bg-white rounded-xl shadow-lg border border-zinc-200 w-full max-w-md overflow-hidden flex flex-col mx-4">
			<div class="px-6 py-4 border-b border-zinc-200 flex justify-between items-center bg-zinc-50">
				<div>
					<h3 class="font-bold text-zinc-950 text-base">{ i18n.T(ctx, "inbox.mock.title") }</h3>
					<p class="text-xs text-zinc-500 mt-1">{ i18n.T(ctx, "inbox.mock.description") }</p>
				</div>
				<button type="button" onclick="closeModal()" class="text-zinc-400 hover:text-zinc-600 text-2xl font-semibold leading-none">&times;</button>
			</div>
			<form hx-post="/admin/inbox/mock-inbound" hx-target="#mock-inbound-error" hx-swap="innerHTML" class="p-6 flex flex-col gap-4 bg-white">
				<div id="mock-inbound-error" class="text-sm text-red-600"></div>
				<div>
					<label class="block text-xs font-bold text-zinc-500 uppercase mb-2">{ i18n.T(ctx, "inbox.mock.connection") }</label>
					<select name="connection_id" class="w-full rounded-lg border border-zinc-200 p-2.5 text-sm bg-white text-zinc-800">
						for _, conn := range connections {
							<option value={ conn.ID.String() }>{ conn.Name }</option>
						}
					</select>
				</div>
				<div>
					<label class="block text-xs font-bold text-zinc-500 uppercase mb-2">{ i18n.T(ctx, "inbox.mock.contact_name") }</label>
					<input name="name" type="text" placeholder={ i18n.T(ctx, "inbox.mock.contact_name_placeholder") } class="w-full rounded-lg border border-zinc-200 p-2.5 text-sm text-zinc-800"/>
				</div>
				<div>
					<label class="block text-xs font-bold text-zinc-500 uppercase mb-2">{ i18n.T(ctx, "inbox.mock.contact_id") }</label>
					<input name="from" required type="text" placeholder={ i18n.T(ctx, "inbox.mock.contact_id_placeholder") } class="w-full rounded-lg border border-zinc-200 p-2.5 text-sm text-zinc-800"/>
				</div>
				<div>
					<label class="block text-xs font-bold text-zinc-500 uppercase mb-2">{ i18n.T(ctx, "common.message") }</label>
					<textarea name="body" required placeholder={ i18n.T(ctx, "inbox.mock.body_placeholder") } class="w-full rounded-lg border border-zinc-200 p-2.5 text-sm h-24 resize-none text-zinc-800"></textarea>
				</div>
				<div class="flex justify-end gap-2 mt-2 border-t border-zinc-100 pt-4">
					<button type="button" onclick="closeModal()" class="px-4 py-2 border border-zinc-200 rounded-lg text-sm font-semibold text-zinc-700 bg-white hover:bg-zinc-50">{ i18n.T(ctx, i18n.CommonCancel) }</button>
					<button type="submit" class="px-4 py-2 bg-violet-600 hover:bg-violet-700 text-white rounded-lg text-sm font-semibold">{ i18n.T(ctx, "inbox.mock.create") }</button>
				</div>
			</form>
		</div>
	</div>
}
